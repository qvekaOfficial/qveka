# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# On Vercel: Settings -> Environment Variables (Production + Preview + Dev).
# ---------------------------------------------------------------------------

# --- Site URL (social share cards + canonical links) ------------------------
# Absolute production URL used for og:image and canonical tags.
SITE_URL=https://www.qveka.com

# --- Firebase Web SDK -------------------------------------------------------
# Firebase console -> Project settings -> General -> Your apps -> Web app.
# These are meant to be public; the deny-all Firestore rules protect the data.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# --- Firebase Admin SDK (SERVER ONLY) ---------------------------------------
# Firebase console -> Project settings -> Service accounts
#   -> Generate new private key. Take these three fields from the JSON.
# NEVER prefix these with NEXT_PUBLIC_ — that would leak them to the browser.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the quotes and the literal \n sequences exactly as they appear.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# --- Recipients (change these without touching any code) --------------------
# Where every new contact-form enquiry is emailed.
NOTIFY_EMAIL=tribhuvan.developer@gmail.com
# The only account permitted to sign in at /admin.
ADMIN_EMAIL=tribhuvan.developer@gmail.com

# --- Email sending (SMTP) ---------------------------------------------------
# Leave SMTP_HOST empty to use Gmail. Gmail needs 2-Step Verification and an
# App Password from https://myaccount.google.com/apppasswords (not your normal
# password). SMTP_USER is also the address the email is sent "from".
#
# For a custom domain mailbox instead (recommended - better deliverability,
# and it uses the normal mailbox password, no App Password needed):
#   Hostinger : SMTP_HOST=smtp.hostinger.com   SMTP_PORT=465
#   Titan     : SMTP_HOST=smtp.titan.email     SMTP_PORT=465
# Port 465 = implicit TLS (recommended). Port 587 = STARTTLS.
#
# Leave SMTP_HOST empty for Gmail. For a Hostinger domain mailbox:
#   SMTP_HOST=smtp.hostinger.com  (port 465), SMTP_USER=you@yourdomain.com,
#   SMTP_PASS=<the mailbox password you set in hPanel - no App Password needed>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=you@yourdomain.com
SMTP_PASS=
